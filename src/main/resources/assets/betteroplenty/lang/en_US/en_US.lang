biome.betteroplenty.bop.bayou=Bayou
biome.betteroplenty.bop.marsh=Marsh
biome.betteroplenty.bop.silkglades=Silkglades
biome.betteroplenty.bop.moor=Moor
biome.betteroplenty.bop.fen=Fen
biome.betteroplenty.bop.lush_swamp=Lush Swamp

tile.betteroplenty.willow.drape.name=Willow Drape
tile.betteroplenty.willow.drape.desc=Pale strands trailed off a bayou cypress. Shears will take it down.
tile.betteroplenty.ivy.name=Ivy
tile.betteroplenty.ivy.desc=It hangs off a swamp canopy, and unlike the rest of them you can climb it.

