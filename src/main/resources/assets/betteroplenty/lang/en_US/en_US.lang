biome.betteroplenty.bop.mystic_grove=Mystic Grove
biome.betteroplenty.bop.mystic_grove_thin=Thinned Mystic Grove
biome.betteroplenty.bop.oasis=Oasis
biome.betteroplenty.bop.sacred_springs=Sacred Springs
biome.betteroplenty.bop.woodland=Woodland
biome.betteroplenty.bop.wetland=Wetland

