# the class: BiomeGenShrublandForest shows as "Thick Shrubland" and BiomeGenFieldForest as
# "Forested Field". Three of these -- Shrubland, Meadow and Boreal Forest -- share a display name
# with a BTA biome. Kept: the registry keys are namespaced and distinct, and the settled rule is
# that a BOP player should find BOP's biomes named as BOP named them.
biome.betteroplenty.bop.shrubland=Shrubland
biome.betteroplenty.bop.shrubland_forest=Thick Shrubland
biome.betteroplenty.bop.field=Field
biome.betteroplenty.bop.field_forest=Forested Field
biome.betteroplenty.bop.meadow=Meadow
biome.betteroplenty.bop.meadow_forest=Meadow Forest
biome.betteroplenty.bop.spruce_woods=Spruce Woods
biome.betteroplenty.bop.boreal_forest=Boreal Forest
biome.betteroplenty.bop.redwood_forest=Redwood Forest
biome.betteroplenty.bop.prairie=Prairie

# Batch 10 -- savanna and scrub. Display names from setBiomeName(...), not the class name.
biome.betteroplenty.bop.scrubland=Scrubland
biome.betteroplenty.bop.dead_forest=Dead Forest
biome.betteroplenty.bop.savanna=Savanna
biome.betteroplenty.bop.savanna_plateau=Savanna Plateau
biome.betteroplenty.bop.steppe=Steppe
biome.betteroplenty.bop.overgrown_greens=Overgrown Greens

