biome.betteroplenty.bop.chaparral=Chaparral
biome.betteroplenty.bop.orchard=Orchard
biome.betteroplenty.bop.pasture=Pasture
biome.betteroplenty.bop.pasture_meadow=Pasture Meadow
biome.betteroplenty.bop.pasture_thin=Thinned Pasture

# The red rock family. Block keys are DOT-separated even though block ids are snake_case --
# HalpLibe derives the key as name.replace("_", "."), so "red_rock" keys as "red.rock".
